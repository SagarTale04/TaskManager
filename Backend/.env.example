# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connections
DATABASE_URL=postgresql://username:password@localhost:5432/syncsprint
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/syncsprint_test

# Client / CORS Origins (comma-separated if multiple)
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
